.intent-cli/supervision/**/cycles.jsonl
.intent-cli/supervision/**/stalls.jsonl

# project skills (trackable)
.opencode/*
!.opencode/skill/
# worker delegation contracts (herdr-opencode-loop)
!.opencode/*-contract.md

/target
# nix build output symlinks
/result
/result-*
# Local user config with provider credentials
/evorch.toml
!/.evorch/
/.evorch/*
# Only the checked-in evorch development skill is shareable; keep other local state ignored.
!/.evorch/skills/
/.evorch/skills/*
!/.evorch/skills/evorch-builtin-skill-authoring/
/.evorch/skills/evorch-builtin-skill-authoring/*
!/.evorch/skills/evorch-builtin-skill-authoring/SKILL.md
