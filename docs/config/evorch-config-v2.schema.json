{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Config",
  "description": "設定ファイルのルート構造。\n\n各セクションは [`serde(default)`] により省略可能ですが、未知のキーは拒否します。\nロード経路では [`crate::strict`] がドット区切りの設定パスを報告し、直接の serde\nパースでも `deny_unknown_fields` により拒否します。",
  "type": "object",
  "properties": {
    "agents": {
      "description": "ロール別エージェントバインディング。",
      "$ref": "#/$defs/AgentsConfig",
      "default": {
        "explorer": {
          "categories": {},
          "generation": {}
        },
        "orchestrator": {
          "categories": {},
          "generation": {}
        },
        "reviewer": {
          "categories": {},
          "generation": {}
        },
        "worker": {
          "categories": {},
          "generation": {}
        }
      }
    },
    "compaction": {
      "description": "コンテキスト圧縮設定。",
      "$ref": "#/$defs/CompactionConfig",
      "default": {
        "context_window_tokens": 200000,
        "cooldown_turns": 1,
        "enabled": true,
        "keep_recent_tokens": 20000,
        "max_compactions_per_run": 32,
        "max_summary_bytes": 16384,
        "model_overrides": {},
        "summarizer": "model",
        "threshold": 0.75
      }
    },
    "diagnostics": {
      "description": "診断 (ログ) 設定。",
      "$ref": "#/$defs/DiagnosticsConfig",
      "default": {
        "log_level": "info"
      }
    },
    "metrics": {
      "description": "メトリクス設定。",
      "$ref": "#/$defs/MetricsConfig",
      "default": {
        "enabled": true,
        "retention_days": 30
      }
    },
    "panel": {
      "description": "パネル UI 設定。",
      "$ref": "#/$defs/PanelConfig",
      "default": {
        "keybinds": {},
        "layout": "default"
      }
    },
    "permissions": {
      "description": "権限設定。",
      "$ref": "#/$defs/PermissionConfig",
      "default": {
        "preset": "default"
      }
    },
    "providers": {
      "description": "プロバイダプロファイル (マップキーがプロファイル名)。",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ProviderProfileConfig"
      },
      "default": {}
    },
    "routing": {
      "description": "ルーティング設定。",
      "$ref": "#/$defs/RoutingConfig",
      "default": {
        "routes": {}
      }
    },
    "rules": {
      "description": "プロジェクトルール注入設定。",
      "$ref": "#/$defs/RulesConfig",
      "default": {
        "context_window_tokens": 200000,
        "max_injection_bytes": 65536,
        "response_headroom_tokens": 16384
      }
    },
    "version": {
      "description": "設定スキーマのバージョン。",
      "type": "integer",
      "format": "uint32",
      "default": 2,
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "$defs": {
    "AgentsConfig": {
      "description": "ロール別のエージェントバインディング設定。",
      "type": "object",
      "properties": {
        "explorer": {
          "description": "explorer ロールのバインディング。",
          "$ref": "#/$defs/RoleBindingConfig",
          "default": {
            "categories": {},
            "generation": {}
          }
        },
        "orchestrator": {
          "description": "オーケストレータロールのバインディング。",
          "$ref": "#/$defs/RoleBindingConfig",
          "default": {
            "categories": {},
            "generation": {}
          }
        },
        "reviewer": {
          "description": "reviewer ロールのバインディング。",
          "$ref": "#/$defs/RoleBindingConfig",
          "default": {
            "categories": {},
            "generation": {}
          }
        },
        "worker": {
          "description": "worker ロールのバインディング。",
          "$ref": "#/$defs/RoleBindingConfig",
          "default": {
            "categories": {},
            "generation": {}
          }
        }
      },
      "additionalProperties": false
    },
    "ApiProtocolConfig": {
      "description": "モデルとの通信に用いる API プロトコル (設定ファイル上の表現)。\n\nシリアライズ識別子はケバブケース (例: `anthropic-messages`) です。\n`OpenAi` 系は [`ProviderTypeConfig`] と同様に語を分割しない識別子\n(`openai-responses`・`openai-completions`・`openai-codex-responses`) として直列化します (ADR 0004)。",
      "oneOf": [
        {
          "description": "Anthropic Messages API。",
          "type": "string",
          "const": "anthropic-messages"
        },
        {
          "description": "OpenAI Responses API。",
          "type": "string",
          "const": "openai-responses"
        },
        {
          "description": "OpenAI Chat Completions API。",
          "type": "string",
          "const": "openai-completions"
        },
        {
          "description": "OpenAI Codex Responses API。Codex subscription backend は `store=false` と `stream=true` を強制する。",
          "type": "string",
          "const": "openai-codex-responses"
        }
      ]
    },
    "CategoryBindingConfig": {
      "description": "カテゴリ 1 件分のバインディング設定。",
      "type": "object",
      "properties": {
        "generation": {
          "description": "生成パラメータの上書き。",
          "$ref": "#/$defs/GenerationOverridesConfig",
          "default": {}
        },
        "logical_model": {
          "description": "使用する論理モデル名。省略時はロール側の指定に従う。",
          "type": [
            "string",
            "null"
          ]
        },
        "preset": {
          "description": "使用するプリセット名。省略時はロール側の指定に従う。",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "CompactionConfig": {
      "description": "コンテキスト圧縮の設定。",
      "type": "object",
      "properties": {
        "context_window_tokens": {
          "description": "既定のコンテキストウィンドウ上限トークン数。",
          "type": "integer",
          "format": "uint64",
          "default": 200000,
          "minimum": 0
        },
        "cooldown_turns": {
          "description": "圧縮後に再圧縮を抑制するターン数。",
          "type": "integer",
          "format": "uint32",
          "default": 1,
          "minimum": 0
        },
        "enabled": {
          "description": "コンテキスト圧縮の有効フラグ。",
          "type": "boolean",
          "default": true
        },
        "keep_recent_tokens": {
          "description": "圧縮せずに保持する直近トークン数。",
          "type": "integer",
          "format": "uint64",
          "default": 20000,
          "minimum": 0
        },
        "max_compactions_per_run": {
          "description": "1 run あたりの圧縮回数の上限 (DoS/暴走防止)。",
          "type": "integer",
          "format": "uint64",
          "default": 32,
          "minimum": 0
        },
        "max_summary_bytes": {
          "description": "要約本文の最大バイト数。",
          "type": "integer",
          "format": "uint64",
          "default": 16384,
          "minimum": 0
        },
        "model_overrides": {
          "description": "モデル ID ごとのコンテキストウィンドウ上限トークン数。",
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "default": {}
        },
        "summarizer": {
          "description": "要約に使用する方式。",
          "$ref": "#/$defs/SummarizerKind",
          "default": "model"
        },
        "threshold": {
          "description": "圧縮を開始するコンテキスト使用率の閾値。",
          "type": "number",
          "format": "double",
          "default": 0.75
        }
      },
      "additionalProperties": false
    },
    "CredentialRefConfig": {
      "description": "認証情報の参照方法。\n\n秘密情報そのものは一切保持せず、取得先 (キーリングのサービス名・アカウント名、\nまたは環境変数名) のみを表現します。この型が秘密素材を含まないことは\nこのクレートのハードな契約です。",
      "oneOf": [
        {
          "description": "OS のキーリングから取得する。",
          "type": "object",
          "properties": {
            "account": {
              "description": "キーリングのアカウント名。",
              "type": "string"
            },
            "service": {
              "description": "キーリングのサービス名。",
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "keyring"
            }
          },
          "required": [
            "type",
            "service",
            "account"
          ]
        },
        {
          "description": "環境変数から取得する。",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "env"
            },
            "var": {
              "description": "環境変数名。",
              "type": "string"
            }
          },
          "required": [
            "type",
            "var"
          ]
        }
      ]
    },
    "DiagnosticsConfig": {
      "description": "診断 (ログ出力) の設定。",
      "type": "object",
      "properties": {
        "log_dir": {
          "description": "ログ出力ディレクトリ。未指定の場合は既定の位置を使用する。",
          "type": [
            "string",
            "null"
          ]
        },
        "log_level": {
          "description": "ログレベル (`trace`/`debug`/`info`/`warn`/`error`)。",
          "type": "string",
          "default": "info"
        }
      },
      "additionalProperties": false
    },
    "GenerationOverridesConfig": {
      "description": "生成パラメータの上書き指定。指定したフィールドのみ反映する。",
      "type": "object",
      "properties": {
        "max_tokens": {
          "description": "最大出力トークン数。",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "reasoning_effort": {
          "description": "推論強度。",
          "anyOf": [
            {
              "$ref": "#/$defs/ReasoningEffortConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "temperature": {
          "description": "サンプリング温度。",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "top_p": {
          "description": "nucleus サンプリングの確率質量。",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "additionalProperties": false
    },
    "MetricsConfig": {
      "description": "メトリクス収集の設定。",
      "type": "object",
      "properties": {
        "enabled": {
          "description": "メトリクス収集の有効フラグ。",
          "type": "boolean",
          "default": true
        },
        "retention_days": {
          "description": "メトリクスの保持日数。",
          "type": "integer",
          "format": "uint32",
          "default": 30,
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "PanelConfig": {
      "description": "パネル UI の設定。",
      "type": "object",
      "properties": {
        "keybinds": {
          "description": "キーバインド (アクション名からキーへのマップ)。",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "layout": {
          "description": "レイアウト名。",
          "type": "string",
          "default": "default"
        }
      },
      "additionalProperties": false
    },
    "PermissionConfig": {
      "description": "権限プリセットの設定。",
      "type": "object",
      "properties": {
        "preset": {
          "description": "権限プリセット名。",
          "type": "string",
          "default": "default"
        }
      },
      "additionalProperties": false
    },
    "ProviderProfileConfig": {
      "description": "プロバイダプロファイル 1 件分の設定。\n\n[`super::Config`] の `providers` マップのキーがプロファイル名になります。",
      "type": "object",
      "properties": {
        "api_protocol": {
          "description": "通信に用いる API プロトコル。",
          "$ref": "#/$defs/ApiProtocolConfig",
          "default": "anthropic-messages"
        },
        "base_url": {
          "description": "API のベース URL。",
          "type": "string",
          "default": "https://api.anthropic.com"
        },
        "credential": {
          "description": "認証情報の参照。",
          "$ref": "#/$defs/CredentialRefConfig",
          "default": {
            "type": "env",
            "var": "ANTHROPIC_API_KEY"
          }
        },
        "default_model": {
          "description": "既定で使用するモデル ID。",
          "type": "string",
          "default": "claude-sonnet-4-5"
        },
        "models": {
          "description": "利用可能なモデル ID の一覧。",
          "type": "array",
          "default": [
            "claude-sonnet-4-5"
          ],
          "items": {
            "type": "string"
          }
        },
        "provider_type": {
          "description": "プロバイダの種別。",
          "$ref": "#/$defs/ProviderTypeConfig",
          "default": "anthropic"
        }
      },
      "additionalProperties": false
    },
    "ProviderTypeConfig": {
      "description": "プロバイダの種別 (設定ファイル上の表現)。\n\nシリアライズ識別子はケバブケース (例: `anthropic-subscription`) です。\n`OpenAi` 系は語を分割しない識別子 (`openai`・`openai-codex`・\n`openai-compatible`) として直列化するため個別に rename します (ADR 0004)。",
      "oneOf": [
        {
          "description": "Anthropic API (従量課金)。",
          "type": "string",
          "const": "anthropic"
        },
        {
          "description": "Anthropic サブスクリプション (Claude Pro / Max)。",
          "type": "string",
          "const": "anthropic-subscription"
        },
        {
          "description": "OpenAI API。",
          "type": "string",
          "const": "openai"
        },
        {
          "description": "OpenAI Codex (ChatGPT サブスクリプション連携)。",
          "type": "string",
          "const": "openai-codex"
        },
        {
          "description": "GitHub Copilot。",
          "type": "string",
          "const": "github-copilot"
        },
        {
          "description": "OpenRouter。",
          "type": "string",
          "const": "openrouter"
        },
        {
          "description": "OpenAI 互換 API (汎用プレースホルダ)。",
          "type": "string",
          "const": "openai-compatible"
        }
      ]
    },
    "ReasoningEffortConfig": {
      "description": "推論強度の指定。",
      "oneOf": [
        {
          "description": "低強度。",
          "type": "string",
          "const": "low"
        },
        {
          "description": "中強度。",
          "type": "string",
          "const": "medium"
        },
        {
          "description": "高強度。",
          "type": "string",
          "const": "high"
        }
      ]
    },
    "RoleBindingConfig": {
      "description": "ロール 1 件分のバインディング設定。",
      "type": "object",
      "properties": {
        "categories": {
          "description": "カテゴリ別のバインディング (キーは固定 6 カテゴリ名)。",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/CategoryBindingConfig"
          },
          "default": {}
        },
        "generation": {
          "description": "生成パラメータの上書き。",
          "$ref": "#/$defs/GenerationOverridesConfig",
          "default": {}
        },
        "logical_model": {
          "description": "使用する論理モデル名。省略時はロール名 (小文字) を使用する。",
          "type": [
            "string",
            "null"
          ]
        },
        "preset": {
          "description": "使用するプリセット名。本文ではなく参照のみを記述する。",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "RouteCandidateConfig": {
      "description": "ルートの候補 1 件分の設定。",
      "type": "object",
      "properties": {
        "model": {
          "description": "モデル ID の上書き指定。省略時はプロファイルの `default_model` を使用する。",
          "type": [
            "string",
            "null"
          ]
        },
        "profile": {
          "description": "使用するプロバイダプロファイル名。",
          "type": "string",
          "default": ""
        }
      },
      "additionalProperties": false
    },
    "RoutingConfig": {
      "description": "ルーティング設定。",
      "type": "object",
      "properties": {
        "routes": {
          "description": "ルート名から候補リスト (フォールバック順) へのマップ。",
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/RouteCandidateConfig"
            }
          },
          "default": {}
        }
      },
      "additionalProperties": false
    },
    "RulesConfig": {
      "description": "プロジェクトルール注入の設定。",
      "type": "object",
      "properties": {
        "context_window_tokens": {
          "description": "モデルのコンテキストウィンドウ上限トークン数。",
          "type": "integer",
          "format": "uint64",
          "default": 200000,
          "minimum": 0
        },
        "max_injection_bytes": {
          "description": "1 回に注入するルール本文の最大バイト数。",
          "type": "integer",
          "format": "uint64",
          "default": 65536,
          "minimum": 0
        },
        "response_headroom_tokens": {
          "description": "応答生成用に予約するトークン数。",
          "type": "integer",
          "format": "uint64",
          "default": 16384,
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "SummarizerKind": {
      "description": "コンテキスト要約の方式。",
      "oneOf": [
        {
          "description": "モデルで要約する。",
          "type": "string",
          "const": "model"
        },
        {
          "description": "構造情報から要約する。",
          "type": "string",
          "const": "structural"
        }
      ]
    }
  }
}
