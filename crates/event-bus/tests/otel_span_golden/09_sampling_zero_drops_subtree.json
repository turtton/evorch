{
  "name": "sampling_zero_drops_subtree",
  "config": { "sampling_ratio": 0.0 },
  "events": [
    {
      "at_ms": 0,
      "kind": { "kind": "Lifecycle", "payload": { "kind": "Started", "payload": { "session_id": "session-1" } } }
    },
    {
      "at_ms": 10,
      "kind": { "kind": "Lifecycle", "payload": { "kind": "AgentRunStarted", "payload": { "run_id": "run-1", "parent_run_id": null, "agent_name": "orchestrator", "role": "orchestrator" } } }
    },
    {
      "at_ms": 20,
      "kind": { "kind": "Provider", "payload": { "kind": "RequestStarted", "payload": { "request_id": "req-1", "provider": "anthropic", "profile": null, "protocol": "anthropic-messages", "model": "kimi-k3", "streaming": true, "run_id": "run-1" } } }
    },
    {
      "at_ms": 30,
      "kind": { "kind": "Tool", "payload": { "kind": "ToolStarted", "payload": { "tool_name": "read", "call_id": "call-1", "run_id": "run-1" } } }
    },
    {
      "at_ms": 40,
      "kind": { "kind": "Lifecycle", "payload": { "kind": "AgentRunStateChanged", "payload": { "run_id": "run-1", "from": "Running", "to": "Done", "reason": null } } }
    },
    {
      "at_ms": 50,
      "kind": { "kind": "Lifecycle", "payload": { "kind": "Completed", "payload": { "session_id": "session-1" } } }
    }
  ],
  "expected_spans": [
    {
      "key": "session:session-1",
      "parent": null,
      "name": "evorch.session",
      "kind": "internal",
      "start_ms": 0,
      "end_ms": 50,
      "status": "unset",
      "attributes": [
        ["evorch.session.id", "session-1"]
      ]
    }
  ],
  "expected_drops": [
    { "kind": "sampled_out", "key": "agent:run-1" },
    { "kind": "sampled_out", "key": "request:req-1" },
    { "kind": "sampled_out", "key": "run:run-1" },
    { "kind": "sampled_out", "key": "tool:call-1" }
  ]
}
