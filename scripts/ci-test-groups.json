      "packages": [
        "runtime",
        "evorch",
        "evorch-core"
      ],
      "features": [
        "storage/test-support"
      ],
      "allow_empty_suites": []
    },
    "gui": {
      "shards": 2,
      "packages": [
        "gui",
        "browser-cef",
        "workspace-ui",
        "workspace-state",
        "core-client-e2e"
      ],
      "features": [
        "storage/test-support"
      ],
      "allow_empty_suites": []
    },
    "storage-tools": {
      "shards": 1,
      "packages": [
        "storage",
        "tools",
        "browser",
        "js-engine",
        "sandbox",
        "test-support"
      ],
      "features": [
        "storage/test-support",
        "sandbox/keychain"
