@@ -0,0 +1,19 @@
+use apply_patch::ChangeKind;
+
+#[test]
+fn labels_name_each_kind() {
+    let s = String::new;
+    assert_eq!(
+        ChangeKind::Added {
+            content: s(),
+            overwritten: None
+        }
+        .label(),
+        "added"
+    );
+    assert_eq!(
+        ChangeKind::Updated { old: s(), new: s() }.label(),
+        "updated"
+    );
+    assert_eq!(ChangeKind::Deleted { old: s() }.label(), "deleted");
+}
